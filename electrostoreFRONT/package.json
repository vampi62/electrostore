{
    "name": "electrostore-front",
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview --port 5050",
        "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts --fix --ignore-path .gitignore",
        "gen:api-types": "openapi-typescript ../openapi/swagger.json -o src/types/api.d.ts",
        "typecheck": "vue-tsc -p tsconfig.json",
        "typecheck:worker": "tsc -p tsconfig.worker.json"
    },
    "dependencies": {
        "@fortawesome/fontawesome-svg-core": "^6.6.0",
        "@fortawesome/free-brands-svg-icons": "^6.6.0",
        "@fortawesome/free-regular-svg-icons": "^6.6.0",
        "@fortawesome/free-solid-svg-icons": "^6.6.0",
        "@fortawesome/vue-fontawesome": "^3.0.8",
        "@types/lodash-es": "^4.17.12",
        "autoprefixer": "^10.4.20",
        "lodash-es": "^4.17.23",
        "pinia": "^2.2.8",
        "postcss": "^8.4.49",
        "tailwindcss": "^3.4.17",
        "vee-validate": "^4.15.0",
        "vue": "^3.5.13",
        "vue-i18n": "^11.1.10",
        "vue-router": "^4.4.5",
        "yup": "^1.6.1"
    },
    "devDependencies": {
        "@typescript-eslint/eslint-plugin": "^8.71.0",
        "@typescript-eslint/parser": "^8.71.0",
        "@vitejs/plugin-vue": "^5.2.3",
        "eslint": "^8.5.0",
        "eslint-plugin-vue": "^8.2.0",
        "openapi-typescript": "^7.13.0",
        "typescript": "^5.9.3",
        "vite": "^6.4.1",
        "vite-plugin-pwa": "^1.2.0",
        "vue-tsc": "^3.3.11"
    }
}
