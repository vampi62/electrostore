<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Confluent.Kafka" Version="2.16.0" />
    <PackageReference Include="Google.Protobuf" Version="3.36.2" />
    <PackageReference Include="Grpc.Net.Client" Version="2.85.0" />
    <PackageReference Include="Grpc.Net.ClientFactory" Version="2.85.0" />
    <PackageReference Include="Grpc.Tools" Version="2.85.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="librdkafka.redist" Version="2.16.0" />
    <PackageReference Include="MailKit" Version="4.18.2" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" /><!-- sub dependency used by MailKit keep this until MailKit updates and fix the dependency issue -->
    <PackageReference Include="VaultSharp" Version="1.17.5.1" />
    <PackageReference Include="WebPush" Version="1.0.13" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Grpc\Protos\config.proto" GrpcServices="Client" />
    <Protobuf Include="Grpc\Protos\users.proto" GrpcServices="Client" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="Templates\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
