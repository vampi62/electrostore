{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Quartz": "Information"
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5000",
        "Protocols": "Http1"
      }
    }
  },
  "Kafka": {
    "BootstrapServers": "<your-kafka-bootstrap-servers>",
    "CronConsumerGroupId": "cron-service-events"
  },
  "ApiServiceGrpcUrl": "http://localhost:5001",
  "Startup": {
    "MaxRetryAttempts": 10,
    "RetryDelaySeconds": 5
  },
  "CronRefreshIntervalMinutes": 5,
  "AppLanguage": "en",
  "Vault": {
    "Enable": false,
    "Addr": "http://vault:8200",
    "Token": "",
    "Path": "",
    "MountPoint": "secret"
  }
}
